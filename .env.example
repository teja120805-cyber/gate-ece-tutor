# GATE ECE Tutor - local configuration.
# GATE-Tutor.bat copies this file to .env on first run. Edit .env (not this file), then restart.
# API keys stay on your computer: only the local server reads them; the browser never sees them.

# Port for http://localhost:PORT
PORT=3210

# ---- AI provider (optional) ------------------------------------------------
# Leave AI_PROVIDER empty to run fully offline. Everything except the AI tutor and
# AI lesson/question generation works without it.
# Options: anthropic | openai | ollama
AI_PROVIDER=

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Any OpenAI-compatible Chat Completions API:
#   OpenAI      OPENAI_BASE_URL=https://api.openai.com/v1
#   OpenRouter  OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Groq        OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Google      OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LM Studio   OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Ollama - free local models (https://ollama.com). Run: ollama pull qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
