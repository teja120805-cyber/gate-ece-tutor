{
  "name": "gate-ece-tutor",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first adaptive GATE ECE learning platform",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "dev": "concurrently -n api,web -c blue,green \"node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=content --import tsx server/index.ts\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test server/tests/*.test.ts",
    "validate-content": "node --disable-warning=ExperimentalWarning --import tsx server/scripts/validate-content.ts",
    "check-math": "tsx --tsconfig tsconfig.json server/scripts/check-math.tsx",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
